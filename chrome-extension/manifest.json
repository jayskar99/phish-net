{
  "manifest_version": 3,
  "name": "Phish Net",
  "version": "0.1.0",
  "description": "Uploads selected emails to the Phish Net API for phishing analysis.",
  "action": {
    "default_title": "Check for phishing",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting", "identity", "downloads"],
  "optional_permissions": ["tabs", "notifications"],
  "oauth2": {
    "client_id": "1051010426634-8q3s0h04o1l1pelpvjhnfbvfp8m10nht.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.readonly"]
  },
  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
